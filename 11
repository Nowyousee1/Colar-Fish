/**
 ****************************************************************************************************
 * @file        motor_pwm.c
 * @brief       电机PWM驱动源文件
 *              TIM2_CH1 (PA5) PWM输出, 用于驱动继电器控制电机
 *              PWM频率 1KHz, 默认100%占空比(继电器常开, 电机全速转动)
 ****************************************************************************************************
 */

#include "./HARDWARE/motor_pwm/motor_pwm.h"


/**
 * @brief       电机PWM初始化
 * @note        配置PA5为TIM2_CH1复用推挽输出
 *              TIM2: PWM模式1, 默认100%占空比, 1KHz频率
 *              PA5需要断开P11跳线帽以确保完全安全
 * @param       无
 * @retval      无
 */
void motor_pwm_init(void)
{
    uint32_t arr = MOTOR_PWM_ARR;
    uint32_t psc = MOTOR_PWM_PSC;

    /* 1. 使能时钟 */
    MOTOR_PWM_GPIO_CLK_ENABLE();        /* GPIOA 时钟 */
    MOTOR_PWM_TIM_CLK_ENABLE();         /* TIM2 时钟 */

    /* 2. 配置PA5为复用输出 */
    sys_gpio_set(MOTOR_PWM_GPIO_PORT, MOTOR_PWM_GPIO_PIN,
                 SYS_GPIO_MODE_AF,          /* 复用功能模式 */
                 SYS_GPIO_OTYPE_PP,         /* 推挽输出 */
                 SYS_GPIO_SPEED_HIGH,       /* 100MHz速度 */
                 SYS_GPIO_PUPD_PU);         /* 上拉 */

    /* 3. 配置PA5复用功能为AF1 (TIM2_CH1) */
    sys_gpio_af_set(MOTOR_PWM_GPIO_PORT, MOTOR_PWM_GPIO_PIN, MOTOR_PWM_GPIO_AF);

    /* 4. 配置TIM2时基 */
    MOTOR_PWM_TIM->ARR = arr;               /* 自动重装值: 999 */
    MOTOR_PWM_TIM->PSC = psc;               /* 预分频值: 83 */

    /* 5. 配置TIM2_CH1 PWM模式1 */
    MOTOR_PWM_TIM->CCMR1 &= ~(0x7 << 4);    /* 清除OC1M[2:0] */
    MOTOR_PWM_TIM->CCMR1 |= 6 << 4;         /* PWM模式1: CNT<CCR时输出有效电平 */
    MOTOR_PWM_TIM->CCMR1 |= 1 << 3;         /* OC1PE: 输出比较1预装载使能 */

    /* 6. 配置输出极性 & 使能输出 */
    MOTOR_PWM_TIM->CCER &= ~(1 << 1);       /* CC1NP=0, CC1P=0: 高电平有效 */
    MOTOR_PWM_TIM->CCER |= 1 << 0;          /* CC1E: 使能OC1输出 */

    /* 7. 初始占空比 100% */
    MOTOR_PWM_TIM->CCR1 = arr;              /* 占空比 = CCR1 / ARR = 100% */

    /* 8. 使能TIM2 */
    MOTOR_PWM_TIM->CR1 |= 1 << 7;           /* ARPE: 自动重装预装载使能 */
    MOTOR_PWM_TIM->EGR |= 1 << 0;           /* UG: 产生更新事件, 初始化所有寄存器 */
    MOTOR_PWM_TIM->CR1 |= 1 << 0;           /* CEN: 使能计数器 */
}


/**
 * @brief       设置PWM占空比值
 * @param       duty: 占空比数值, 范围 0 ~ MOTOR_PWM_ARR (0 ~ 999)
 *              0   = 0%占空比  (输出常低, 继电器断开, 电机停止)
 *              999 = 100%占空比(输出常高, 继电器吸合, 电机全速)
 * @retval      无
 */
void motor_pwm_set_duty(uint16_t duty)
{
    if (duty > MOTOR_PWM_ARR)
    {
        duty = MOTOR_PWM_ARR;
    }
    MOTOR_PWM_TIM->CCR1 = duty;
}


/**
 * @brief       设置PWM占空比(百分比)
 * @param       percent: 占空比百分比, 范围 0 ~ 100
 *              0   = 0%  (电机停止)
 *              100 = 100%(电机全速)
 * @retval      无
 */
void motor_pwm_set_percent(uint8_t percent)
{
    uint16_t duty;

    if (percent > 100)
    {
        percent = 100;
    }

    duty = (uint16_t)((uint32_t)MOTOR_PWM_ARR * percent / 100);
    motor_pwm_set_duty(duty);
}


/**
 * @brief       启动PWM输出
 * @param       无
 * @retval      无
 */
void motor_pwm_start(void)
{
    MOTOR_PWM_TIM->CR1 |= 1 << 0;           /* CEN: 使能计数器 */
}


/**
 * @brief       停止PWM输出
 * @param       无
 * @retval      无
 */
void motor_pwm_stop(void)
{
    MOTOR_PWM_TIM->CR1 &= ~(1 << 0);        /* 关闭计数器 */
}
